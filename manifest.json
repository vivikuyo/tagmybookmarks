{
  "manifest_version": 3,
  "name": "TagMyBookmarks",
  "version": "1.0.3",
  "description": "书签标签化管理：布尔标签查询、相关标签收窄、标签写在标题里，随 Chrome 同步。",
  "homepage_url": "https://github.com/vivikuyo/tagmybookmarks",
  "permissions": ["bookmarks", "storage", "sidePanel", "activeTab", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TagMyBookmarks",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "打开标签面板"
    },
    "open-space": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "打开 TagMyBookmarks 全页"
    }
  },
  "omnibox": {
    "keyword": "tb"
  }
}
